# Discord Bot Credentials
# Replace with your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Monetization & Store Configuration
# Optional: Set your Stripe payment link, LemonSqueezy, Ko-fi, or Discord App Directory URL
PREMIUM_STORE_URL=https://discord.com/application-directory
PREMIUM_PRICE_LABEL=$1/mo

# Bot Administrator & Owner ID (Numeric Discord User ID)
# Used to restrict /license generate and /license revoke commands to only you
BOT_OWNER_ID=your_discord_user_id_here
